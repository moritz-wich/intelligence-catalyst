---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const essays = (await getCollection("essays")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Essays"
  description="Essays on AI, software, products, organizations, and the changing economics of thinking."
>
  <section class="intro">
    <p class="eyebrow">ESSAYS</p>

    <h1>Ideas about what becomes possible when intelligence becomes abundant.</h1>

    <p class="lede">
      Long-form thoughts on AI, software, products, organizations, and the
      changing economics of thinking.
    </p>
  </section>

  <section class="essay-list" aria-label="Essays">
    {essays.map((essay) => (
      <article class="essay">
        <p class="date">{essay.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}</p>
        <h2><a href={`/essays/${essay.id}`}>{essay.data.title}</a></h2>
        <p class="description">{essay.data.description}</p>
        <a class="read-link" href={`/essays/${essay.id}`}>Read essay <span aria-hidden="true">-></span></a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 4rem 0 6rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: #777;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
  }

  h1 {
    max-width: 720px;
    margin: 0;
  }

  .lede {
    max-width: 620px;
    margin-top: 2.5rem;
    color: #666;
    font-size: 1.15rem;
  }

  .essay-list {
    border-top: 1px solid #deded9;
  }

  .essay {
    padding: 2.5rem 0;
    border-bottom: 1px solid #deded9;
  }

  .date {
    margin: 0;
    color: #777;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0.75rem 0 0;
    font-size: 2rem;
    line-height: 1.15;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .description {
    margin: 0.75rem 0 1.25rem;
    color: #666;
  }

  .read-link {
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }
</style>