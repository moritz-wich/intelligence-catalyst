---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{essay.data.title} — Intelligence Catalyst</title>
    <meta name="description" content={essay.data.description} />
  </head>

  <body>
    <main>
      <a href="/essays">← Essays</a>

      <article>
        <h1>{essay.data.title}</h1>

        <p>{essay.data.date}</p>

        <Content />
      </article>
    </main>
  </body>
</html>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    font-family: system-ui, sans-serif;
    line-height: 1.7;
  }

  article {
    margin-top: 4rem;
  }

  h1 {
    font-size: 2.8rem;
    line-height: 1.2;
  }
</style>