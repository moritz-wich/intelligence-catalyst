---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{essay.data.title} — Intelligence Catalyst</title>
    <meta name="description" content={essay.data.description} />
  </head>

  <body>
    <main>
      <a href="/essays">← Essays</a>

      <article>
        <h1>{essay.data.title}</h1>

        <p>{essay.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}</p>

        <Content />
      </article>
    </main>
  </body>
</html>

<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: "strict",
    theme: "neutral",
  });

  const blocks = document.querySelectorAll('pre[data-language="mermaid"]');

  for (const block of blocks) {
    const diagram = document.createElement("div");
    diagram.className = "mermaid";
    diagram.textContent = block.textContent ?? "";
    block.replaceWith(diagram);
  }

  if (blocks.length > 0) {
    await mermaid.run({ querySelector: ".mermaid" });
  }
</script>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    font-family: system-ui, sans-serif;
    line-height: 1.7;
  }

  article {
    margin-top: 4rem;
  }

  h1 {
    font-size: 2.8rem;
    line-height: 1.2;
  }

  .mermaid {
    margin: 2rem 0;
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid #deded9;
    background: #f7f7f5;
  }
</style>