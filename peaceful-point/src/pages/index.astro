---
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Thinking about what becomes possible when intelligence becomes abundant.";
---

<BaseLayout title="Intelligence Catalyst" description={description}>
  <section class="hero">
    <p class="eyebrow">INTELLIGENCE CATALYST</p>

    <h1>Thinking about what becomes possible when intelligence becomes abundant.</h1>

    <p class="intro">
      Essays and notes on AI, software, products, organizations, and the
      changing economics of thinking.
    </p>

    <div class="actions">
      <a href="/essays" class="primary">Read the essays <span aria-hidden="true">-></span></a>
      <a href="/about">About</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 6rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: #777;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
  }

  h1 {
    max-width: 720px;
    margin: 0;
  }

  .intro {
    max-width: 620px;
    margin-top: 2.5rem;
    color: #666;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .actions a {
    text-decoration: none;
  }

  .primary {
    padding: 0.75rem 1rem;
    border: 1px solid #191919;
    background: #191919;
    color: #fff;
  }

  .primary:hover {
    background: #333;
  }
</style>
