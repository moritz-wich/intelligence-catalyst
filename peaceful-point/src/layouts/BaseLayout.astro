---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Thinking about what becomes possible when intelligence becomes abundant.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{title} — Intelligence Catalyst</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="brand">
          <span>Intelligence</span>
          <span>Catalyst</span>
        </a>

        <div class="links">
          <a href="/essays">Essays</a>
          <a href="/notes">Notes</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>Intelligence Catalyst</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f7f5;
    color: #191919;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
  }

  header {
    border-bottom: 1px solid #deded9;
  }

  nav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 2rem;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand span:last-child {
    color: #777;
  }

  .links {
    display: flex;
    gap: 1.75rem;
  }

  .links a {
    color: #666;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .links a:hover {
    color: #191919;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 6rem 2rem;
  }

  footer {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem;
    border-top: 1px solid #deded9;
    color: #888;
    font-size: 0.8rem;
  }

  footer p {
    margin: 0;
  }

  :global(h1),
  :global(h2),
  :global(h3) {
    letter-spacing: -0.035em;
  }

  :global(h1) {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  :global(p) {
    max-width: 68ch;
  }

  @media (max-width: 600px) {
    nav {
      padding: 1.25rem;
    }

    .links {
      gap: 1rem;
    }

    main {
      padding: 4rem 1.25rem;
    }
  }
</style>